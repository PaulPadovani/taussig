aque</td><td><span title=\"SOURCEISBROADERTHANTARGET\">&gt;</span><a href=\"CodeSystem-echsa.html#echsa-DIAG048\">DIAG048</a><i>(défaillance seulement)</i></td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span>T82.9</td><td><span title=\"EQUIVALENT\">~</span><a href=\"CodeSystem-ipccc.html#ipccc-15.4655.4600\">15.55.00</a><i>(libellé TAUSSIG = traduction du terme IPCCC)</i></td></tr><tr><td><a href=\"CodeSystem-taussig-condition.html#taussig-condition-TAUSSIG-COND-0068\">TAUSSIG-COND-0068</a></td><td>Obstruction d'anastomose systémico-pulmonaire</td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span><a href=\"CodeSystem-echsa.html#echsa-DIAG-2010-2130\">DIAG-2010-2130</a><i>(toute défaillance d'anastomose)</i></td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span>T82.5</td><td><span title=\"EQUIVALENT\">~</span><a href=\"CodeSystem-ipccc.html#ipccc-15.4656.4627\">15.56.27</a><i>(libellé TAUSSIG = traduction du terme IPCCC)</i></td></tr><tr><td><a href=\"CodeSystem-taussig-condition.html#taussig-condition-TAUSSIG-COND-0069\">TAUSSIG-COND-0069</a></td><td>Obstruction partielle d'anastomose systémico-pulmonaire</td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span><a href=\"CodeSystem-echsa.html#echsa-DIAG-2010-2130\">DIAG-2010-2130</a><i>(idem)</i></td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span>T82.5</td><td><span title=\"EQUIVALENT\">~</span><a href=\"CodeSystem-ipccc.html#ipccc-15.4656.4601\">15.56.01</a><i>(libellé TAUSSIG = traduction du terme IPCCC)</i></td></tr><tr><td><a href=\"CodeSystem-taussig-condition.html#taussig-condition-TAUSSIG-COND-0070\">TAUSSIG-COND-0070</a></td><td>Obstruction complète d'anastomose systémico-pulmonaire</td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span><a href=\"CodeSystem-echsa.html#echsa-DIAG-2010-2130\">DIAG-2010-2130</a><i>(idem)</i></td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span>T82.5</td><td><span title=\"EQUIVALENT\">~</span><a href=\"CodeSystem-ipccc.ht