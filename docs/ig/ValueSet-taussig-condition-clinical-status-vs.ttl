  fhir:ValueSet.status [ fhir:value "active"] ;
  fhir:ValueSet.experimental [ fhir:value "true"^^xsd:boolean] ;
  fhir:ValueSet.date [ fhir:value "2026-11-09T15:30:29+01:00"^^xsd:dateTime] ;
