<https://taussig/fhir/ConceptMap/taussig-procedure-to-ccam> a fhir:ConceptMap ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "taussig-procedure-to-ccam"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Narratif généré : CarteDeConcepts taussig-procedure-to-ccam</b></p><a name=\"taussig-procedure-to-ccam\"> </a><a name=\"hctaussig-procedure-to-ccam\"> </a><p>Mapping de <a href=\"ValueSet-taussig-procedure.html\">TAUSSIG — Liste des gestes et actes de cathétérisme</a> vers (non spécifié)</p><br/><p>Mapping de <a href=\"CodeSystem-taussig-procedure.html\">TAUSSIG — Gestes et actes de cathétérisme</a> to <a href=\"CodeSystem-ccam.html\">TAUSSIG — CCAM (sous-ensemble cath congénital)</a></p><table class=\"grid\"><tr><td colspan=\"2\"><b>Détails du concept source</b></td><td><b>relation</b></td><td colspan=\"2\"><b>Détails du concept cible</b></td><td><b>Commentaire</b></td></tr><tr><td colspan=\"2\"><b>Codes</b> de <a href=\"CodeSystem-taussig-procedure.html\" title=\"https://taussig/fhir/CodeSystem/taussig-procedure\">TAUSSIG — Gestes et actes de cathétérisme</a></td><td/><td colspan=\"2\"><b>Codes</b> de <a href=\"CodeSystem-ccam.html\" title=\"https://mos.esante.gouv.fr/NOS/TRE_R310-CCAM/FHIR/TRE-R310-CCAM\">TAUSSIG — CCAM (sous-ensemble cath congénital)</a></td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0001</td><td style=\"border-left-width: 0px\">Pose percutanée d'un stent sur un anévrisme de l'aorte thoracique</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DGLF003</td><td style=\"border-left-width: 0px\">Pose d'endoprothèse couverte dans l'aorte thoracique, par voie artérielle transcutanée</td><td>proposé v6</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0002</td><td style=\"border-left-width: 0px\">Stratégie hybride (chirurgie et cathétérisme combinés)</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0003</td><td style=\"border-left-width: 0px\">Cathétérisme par voie transseptale avec ponction transseptale</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — la voie transseptale est incluse dans le libellé de certains actes (ex. DENF014, DASF074)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0004</td><td style=\"border-left-width: 0px\">Test d'occlusion diagnostique par voie percutanée</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0005</td><td style=\"border-left-width: 0px\">Geste percutané avec traitement adjuvant</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0006</td><td style=\"border-left-width: 0px\">Cathétérisme cardiaque diagnostique : angiographie</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DFQH001</td><td style=\"border-left-width: 0px\">Artériographie sélective du tronc et/ou des branches de l'artère pulmonaire, par voie veineuse transcutanée</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0007</td><td style=\"border-left-width: 0px\">Cathétérisme cardiaque diagnostique : recueil des données hémodynamiques</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">EQQF001</td><td style=\"border-left-width: 0px\">Mesure et enregistrement des pressions du cœur droit, de l'artère pulmonaire et du cœur gauche, sans injection de produit de contraste, par voie veineuse transcutanée et par voie artérielle transcutanée ou cathétérisme du foramen ovale</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0008</td><td style=\"border-left-width: 0px\">Cathétérisme cardiaque diagnostique avec épreuve de modification hémodynamique</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">EQQF003</td><td style=\"border-left-width: 0px\">Mesure et enregistrement des pressions intravasculaires pulmonaires et systémiques et des différences artérioveineuses des contenus artériels en oxygène, à l'état basal et après administration d'agent pharmacologique vasodilatateur, par voie vasculaire transcutanée</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0009</td><td style=\"border-left-width: 0px\">Cathétérisme d'évaluation d'une hypertension pulmonaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">EQQF003</td><td style=\"border-left-width: 0px\">Mesure et enregistrement des pressions intravasculaires pulmonaires et systémiques et des différences artérioveineuses des contenus artériels en oxygène, à l'état basal et après administration d'agent pharmacologique vasodilatateur, par voie vasculaire transcutanée</td><td>proposé v6 — mesures à l'état basal et après vasodilatateur</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0010</td><td style=\"border-left-width: 0px\">Cathétérisme diagnostique à visée interventionnelle : anatomie inadaptée au geste</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — notion d'intention de traiter non codée en CCAM</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0011</td><td style=\"border-left-width: 0px\">Geste percutané pour trouble du rythme</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — concept générique</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0012</td><td style=\"border-left-width: 0px\">Geste percutané pour trouble du rythme atrial</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — concept générique</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0013</td><td style=\"border-left-width: 0px\">Geste percutané pour trouble du rythme ventriculaire</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — concept générique</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0014</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Cathétérisme cardiaque diagnostique avec épreuve électrophysiologique</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DEQF001</td><td style=\"border-left-width: 0px\">Exploration électrophysiologique cardiaque par sonde intracavitaire droite par voie veineuse transcutanée, avec manœuvres provocatrices d'une tachycardie à l'étage ventriculaire</td><td>proposé v6 — exploration électrophysiologique avec manœuvres provocatrices</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DEQF002</td><td style=\"border-left-width: 0px\">Exploration électrophysiologique cardiaque par sonde intracavitaire droite par voie veineuse transcutanée, avec manœuvres provocatrices d'une tachycardie à l'étage atrial et à l'étage ventriculaire</td><td>proposé v6 — exploration électrophysiologique avec manœuvres provocatrices</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DEQF004</td><td style=\"border-left-width: 0px\">Exploration électrophysiologique cardiaque par sonde intracavitaire droite par voie veineuse transcutanée, avec manœuvres provocatrices d'une tachycardie à l'étage atrial</td><td>proposé v6 — exploration électrophysiologique avec manœuvres provocatrices</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DEQF005</td><td style=\"border-left-width: 0px\">Exploration électrophysiologique cardiaque par sondes intracavitaires droite et gauche par voie vasculaire transcutanée, avec manœuvres provocatrices d'une tachycardie</td><td>proposé v6 — exploration électrophysiologique avec manœuvres provocatrices</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0015</td><td style=\"border-left-width: 0px\">Exploration électrophysiologique</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DEQF003</td><td style=\"border-left-width: 0px\">Exploration électrophysiologique cardiaque par sonde intracavitaire droite, par voie veineuse transcutanée</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0016</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Exploration électrophysiologique avec cartographie tridimensionnelle</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">DEQF003</td><td style=\"border-left-width: 0px\">Exploration électrophysiologique cardiaque par sonde intracavitaire droite, par voie veineuse transcutanée</td><td>proposé v6 — la CCAM ne distingue pas la cartographie 3D</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">DEQF005</td><td style=\"border-left-width: 0px\">Exploration électrophysiologique cardiaque par sondes intracavitaires droite et gauche par voie vasculaire transcutanée, avec manœuvres provocatrices d'une tachycardie</td><td>proposé v6 — la CCAM ne distingue pas la cartographie 3D</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0017</td><td style=\"border-left-width: 0px\">Geste fœtal</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0018</td><td style=\"border-left-width: 0px\">Coagulation laser des anastomoses placentaires dans le syndrome transfuseur-transfusé</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — absent de la CCAM v82 sous ce libellé</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0019</td><td style=\"border-left-width: 0px\">Geste fœtal par cathéter</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0020</td><td style=\"border-left-width: 0px\">Valvuloplastie pulmonaire fœtale au ballon</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0021</td><td style=\"border-left-width: 0px\">Valvuloplastie aortique fœtale au ballon</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0022</td><td style=\"border-left-width: 0px\">Péricardiocentèse fœtale par cathéter</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">JQHB002</td><td style=\"border-left-width: 0px\">Ponction ou biopsie d'un organe fœtal</td><td>proposé v6 — ponction ou biopsie d'un organe fœtal</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0023</td><td style=\"border-left-width: 0px\">Atrioseptostomie fœtale au ballon</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0024</td><td style=\"border-left-width: 0px\">Cathétérisme thérapeutique avec échec de largage d'un dispositif, d'un stent ou d'un coil</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — échec de largage non codé en CCAM</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0025</td><td style=\"border-left-width: 0px\">Geste de cathétérisme cardiovasculaire</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — concept générique</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0026</td><td style=\"border-left-width: 0px\">Nouveau cathétérisme pour lésion résiduelle ou récidivante</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — notion de reprise non codée en CCAM</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0027</td><td style=\"border-left-width: 0px\">Redilatation de stent</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — redilatation de stent non distinguée en CCAM</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0028</td><td style=\"border-left-width: 0px\">Pose de stent</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — concept générique : la CCAM code la pose d'endoprothèse par site</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0029</td><td style=\"border-left-width: 0px\">Dilatation au ballon</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — concept générique : la CCAM code la dilatation par site</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0030</td><td style=\"border-left-width: 0px\">Implantation d'un dispositif par voie percutanée</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0031</td><td style=\"border-left-width: 0px\">Occlusion par coil au cours d'un cathétérisme</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — concept générique : la CCAM code l'embolisation par site</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0032</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Implantation percutanée d'une valve</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DBLF001</td><td style=\"border-left-width: 0px\">Pose d'une bioprothèse de la valve aortique, par voie artérielle transcutanée</td><td>proposé v6 — aortique ou pulmonaire ; pas de code percutané tricuspide ou mitral</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DBLF009</td><td style=\"border-left-width: 0px\">Pose d'une bioprothèse de la valve pulmonaire par voie veineuse transcutanée</td><td>proposé v6 — aortique ou pulmonaire ; pas de code percutané tricuspide ou mitral</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0033</td><td style=\"border-left-width: 0px\">Fermeture percutanée d'une fuite de prothèse valvulaire par dispositif</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DBSF001</td><td style=\"border-left-width: 0px\">Fermeture d'une déhiscence par désinsertion de prothèse orificielle cardiaque, par voie vasculaire transcutanée</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0034</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Dilatation valvulaire au ballon</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DBAF001</td><td style=\"border-left-width: 0px\">Dilatation intraluminale de l'orifice aortique, par voie artérielle transcutanée</td><td>proposé v6 — selon la valve</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DBAF002</td><td style=\"border-left-width: 0px\">Dilatation intraluminale de l'orifice pulmonaire sans perforation de la valve atrésique, par voie veineuse transcutanée</td><td>proposé v6 — selon la valve</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DBAF003</td><td style=\"border-left-width: 0px\">Dilatation intraluminale de l'orifice atrioventriculaire droit, par voie veineuse transcutanée</td><td>proposé v6 — selon la valve</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DBAF004</td><td style=\"border-left-width: 0px\">Dilatation intraluminale de l'orifice atrioventriculaire gauche, par voie veineuse transcutanée avec perforation du septum interatrial</td><td>proposé v6 — selon la valve</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0035</td><td style=\"border-left-width: 0px\">Cathétérisme cardiovasculaire thérapeutique</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6 — concept générique</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0036</td><td style=\"border-left-width: 0px\">Perforation thérapeutique percutanée pour créer une communication entre cavités ou vaisseaux</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DBAF005</td><td style=\"border-left-width: 0px\">Dilatation intraluminale de l'orifice pulmonaire avec perforation de la valve atrésique, par voie veineuse transcutanée</td><td>proposé v6 — seule la perforation de valve pulmonaire atrésique est codée</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0037</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Cathétérisme cardiaque diagnostique</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">EQQF001</td><td style=\"border-left-width: 0px\">Mesure et enregistrement des pressions du cœur droit, de l'artère pulmonaire et du cœur gauche, sans injection de produit de contraste, par voie veineuse transcutanée et par voie artérielle transcutanée ou cathétérisme du foramen ovale</td><td>proposé v6 — choisir selon cavités explorées, injection et âge (EQQH005 &lt; 24 mois, EQQH006 ≥ 24 mois)</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">EQQF006</td><td style=\"border-left-width: 0px\">Mesure et enregistrement des pressions du cœur droit et de l'artère pulmonaire, sans injection de produit de contraste, par voie veineuse transcutanée</td><td>proposé v6 — choisir selon cavités explorées, injection et âge (EQQH005 &lt; 24 mois, EQQH006 ≥ 24 mois)</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">EQQH001</td><td style=\"border-left-width: 0px\">Mesure et enregistrement des pressions du cœur droit et de l'artère pulmonaire, avec injection de produit de contraste, par voie veineuse transcutanée</td><td>proposé v6 — choisir selon cavités explorées, injection et âge (EQQH005 &lt; 24 mois, EQQH006 ≥ 24 mois)</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">EQQH005</td><td style=\"border-left-width: 0px\">Mesure et enregistrement des pressions du cœur droit, de l'artère pulmonaire et du cœur gauche, avec injection de produit de contraste, par voie veineuse transcutanée et par voie artérielle transcutanée ou cathétérisme du foramen ovale, avant l'âge de 24 mois</td><td>proposé v6 — choisir selon cavités explorées, injection et âge (EQQH005 &lt; 24 mois, EQQH006 ≥ 24 mois)</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">EQQH006</td><td style=\"border-left-width: 0px\">Mesure et enregistrement des pressions du cœur droit, de l'artère pulmonaire et du cœur gauche, avec injection de produit de contraste, par voie veineuse transcutanée et par voie artérielle transcutanée ou cathétérisme du foramen ovale, à l'âge de 24 mois ou plus</td><td>proposé v6 — choisir selon cavités explorées, injection et âge (EQQH005 &lt; 24 mois, EQQH006 ≥ 24 mois)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0038</td><td style=\"border-left-width: 0px\">Agrandissement d'une communication interventriculaire</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0039</td><td style=\"border-left-width: 0px\">Agrandissement ou création d'une communication interventriculaire</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td><td style=\"background-color: #efefef\">proposé v6</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0040</td><td style=\"border-left-width: 0px\">Approche hybride de l'hypoplasie du cœur gauche (cathétérisme et chirurgie) : stade 1</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0041</td><td style=\"border-left-width: 0px\">Approche hybride de l'hypoplasie du cœur gauche, stade 2 : amalgame aorto-pulmonaire, anastomose(s) cavo-pulmonaire(s) supérieure(s) et retrait des cerclages pulmonaires</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0042</td><td style=\"border-left-width: 0px\">Approche hybride de l'hypoplasie du cœur gauche, stade 2 : amalgame aorto-pulmonaire, anastomose(s) cavo-pulmonaire(s) supérieure(s), retrait des cerclages pulmonaires et réparation de l'arche</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-PROC-0043</td><td style=\"border-left-width: 0px\">Échographie endocoronaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DDQJ001</td><td style=\"border-left-width: 0px\">Échographie et/ou échographie-doppler intraartérielle coronaire, au cours d'un acte par voie vasculaire transcutanée</td><td>proposé v6</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-PROC-0044</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Échocardiographie</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\"