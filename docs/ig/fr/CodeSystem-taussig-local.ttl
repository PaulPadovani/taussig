     fhir:CodeSystem.concept.code [ fhir:value "TAUSSIG-CAVOPULM-INF" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Dérivation cavopulmonaire inférieure (VCI vers artère pulmonaire)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Anastomose entre la veine cave inférieure et l'artère pulmonaire, isolée. SNOMED CT ne\n    fournit de concept que pour la dérivation supérieure (443327008) et pour la dérivation\n    totale (443298009), et aucune structure corporelle pour la composante inférieure seule." ]
