     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Narratif généré : CarteDeConcepts taussig-diagnosis-to-echsa</b></p><a name=\"taussig-diagnosis-to-echsa\"> </a><a name=\"hctaussig-diagnosis-to-echsa\"> </a><p>Mapping de <a href=\"ValueSet-taussig-diagnosis.html\">TAUSSIG — Liste des diagnostics cardiaques congénitaux</a> vers (non spécifié)</p><br/><p>Mapping de <a href=\"CodeSystem-taussig-diagnosis.html\">TAUSSIG — Diagnostics cardiaques congénitaux</a> to <a href=\"CodeSystem-echsa.html\">TAUSSIG — ECHSA (nomenclature EACTS-ECHSA, représentation POC)</a></p><table class=\"grid\"><tr><td colspan=\"2\"><b>Détails du concept source</b></td><td><b>relation</b></td><td colspan=\"2\"><b>Détails du concept cible</b></td><td><b>Commentaire</b></td></tr><tr><td colspan=\"2\"><b>Codes</b> de <a href=\"CodeSystem-taussig-diagnosis.html\" title=\"https://taussig/fhir/CodeSystem/taussig-diagnosis\">TAUSSIG — Diagnostics cardiaques congénitaux</a></td><td/><td colspan=\"2\"><b>Codes</b> de <a href=\"CodeSystem-echsa.html\" title=\"https://taussig/fhir/CodeSystem/echsa\">TAUSSIG — ECHSA (nomenclature EACTS-ECHSA, représentation POC)</a></td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0001</td><td style=\"border-left-width: 0px\">Anomalie de position-orientation du cœur</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0002</td><td style=\"border-left-width: 0px\">Lévocardie</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG-2010-2100</td><td style=\"border-left-width: 0px\">Levocardia</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0003</td><td style=\"border-left-width: 0px\">Dextrocardie</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG-2010-2090</td><td style=\"border-left-width: 0px\">Dextrocardia</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0004</td><td style=\"border-left-width: 0px\">Mésocardie</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG-2010-2110</td><td style=\"border-left-width: 0px\">Mesocardia</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0005</td><td style=\"border-left-width: 0px\">Image en miroir complète</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">DIAG-2010-2120</td><td style=\"border-left-width: 0px\">Situs inversus</td><td>« situs inversus » sans précision de totalité</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0006</td><td style=\"border-left-width: 0px\">Isomérisme droit</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG115</td><td style=\"border-left-width: 0px\">Atrial Isomerism, Right</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0007</td><td style=\"border-left-width: 0px\">Isomérisme gauche</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG114</td><td style=\"border-left-width: 0px\">Atrial Isomerism, Left</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0008</td><td style=\"border-left-width: 0px\">Anomalie congénitale d'une connexion auriculoventriculaire ou ventriculoartérielle</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0009</td><td style=\"border-left-width: 0px\">Connexions atrioventriculaires discordantes</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0010</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Transposition congénitalement corrigée des grandes artères</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG082</td><td style=\"border-left-width: 0px\">Congenitally corrected TGA</td><td/></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG155</td><td style=\"border-left-width: 0px\">Congenitally corrected TGA, VSD</td><td>avec CIV</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0011</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Transposition des gros vaisseaux</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG083</td><td style=\"border-left-width: 0px\">TGA, IVS</td><td>sous-type de TGV selon la CIV et l'obstacle gauche</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG084</td><td style=\"border-left-width: 0px\">TGA, IVS-LVOTO</td><td>sous-type de TGV selon la CIV et l'obstacle gauche</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG085</td><td style=\"border-left-width: 0px\">TGA, VSD</td><td>sous-type de TGV selon la CIV et l'obstacle gauche</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG086</td><td style=\"border-left-width: 0px\">TGA, VSD-LVOTO</td><td>sous-type de TGV selon la CIV et l'obstacle gauche</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0012</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Ventricule droit à double issue</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG088</td><td style=\"border-left-width: 0px\">DORV, VSD type</td><td>type CIV</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG-2024-3</td><td style=\"border-left-width: 0px\">DORV</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0013</td><td style=\"border-left-width: 0px\">Ventricule droit à double sortie avec communication interventriculaire sous-pulmonaire de type transposition</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG090</td><td style=\"border-left-width: 0px\">DORV, TGA type</td><td>type TGV (Taussig-Bing)</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0014</td><td style=\"border-left-width: 0px\">Ventricule droit à double sortie avec communication interventriculaire sans relation avec les deux gros vaisseaux</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG091</td><td style=\"border-left-width: 0px\">DORV, Remote VSD (uncommitted VSD)</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0015</td><td style=\"border-left-width: 0px\">Ventricule droit à double sortie avec communication interventriculaire sous-aortique ou en relation avec les deux gros vaisseaux sans sténose pulmonaire, type communication interventriculaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG088</td><td style=\"border-left-width: 0px\">DORV, VSD type</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0016</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Ventricule droit à double sortie avec communication interventriculaire sous-aortique ou en relation avec les deux gros vaisseaux et sténose pulmonaire de type Fallot</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG089</td><td style=\"border-left-width: 0px\">DORV, TOF type</td><td/></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG-2024-4</td><td style=\"border-left-width: 0px\">DORV, Fallot type</td><td>doublon ECHSA de DIAG089</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0017</td><td style=\"border-left-width: 0px\">Ventricule gauche à double issue</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG093</td><td style=\"border-left-width: 0px\">DOLV</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0018</td><td style=\"border-left-width: 0px\">Tronc artériel commun</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG016</td><td style=\"border-left-width: 0px\">Truncus arteriosus</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0019</td><td style=\"border-left-width: 0px\">Tronc artériel commun à dominance aortique</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">DIAG016</td><td style=\"border-left-width: 0px\">Truncus arteriosus</td><td>ECHSA ne précise pas la dominance</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0020</td><td style=\"border-left-width: 0px\">Tronc artériel commun à dominance pulmonaire et arc aortique interrompue</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG-2010-2010</td><td style=\"border-left-width: 0px\">Truncus arteriosus + Interrupted aortic arch</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0021</td><td style=\"border-left-width: 0px\">Anomalie congénitale de la veine médiastinale</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0022</td><td style=\"border-left-width: 0px\">Veine cave supérieure gauche</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">DIAG026</td><td style=\"border-left-width: 0px\">Systemic venous anomaly</td><td>anomalie veineuse systémique, non précisée</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0023</td><td style=\"border-left-width: 0px\">Absence de toit du sinus coronaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DIAG004</td><td style=\"border-left-width: 0px\">ASD, Coronary sinus</td><td>le code ECHSA décrit la CIA par le sinus coronaire (rang 100), pas toute absence de toit</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0024</td><td style=\"border-left-width: 0px\">Anomalie du retour veineux pulmonaire</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0025</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Connexion veineuse pulmonaire totale anormale</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG019</td><td style=\"border-left-width: 0px\">Total anomalous pulmonary venous connection (TAPVC), Type 1 (supracardiac)</td><td>type de RVPAT</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG020</td><td style=\"border-left-width: 0px\">Total anomalous pulmonary venous connection (TAPVC), Type 2 (cardiac)</td><td>type de RVPAT</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG021</td><td style=\"border-left-width: 0px\">Total anomalous pulmonary venous connection (TAPVC), Type 3 (infracardiac)</td><td>type de RVPAT</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG022</td><td style=\"border-left-width: 0px\">Total anomalous pulmonary venous connection (TAPVC), Type 4 (mixed)</td><td>type de RVPAT</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0026</td><td style=\"border-left-width: 0px\">Connexion veineuse pulmonaire partielle anormale</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG017</td><td style=\"border-left-width: 0px\">Partial anomalous pulmonary venous connection (PAPVC)</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0027</td><td style=\"border-left-width: 0px\">Syndrome du cimeterre</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG018</td><td style=\"border-left-width: 0px\">Partial anomalous pulmonary venous connection (PAPVC), scimitar</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0028</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Sténose ou hypoplasie veineuse pulmonaire congénitale</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">DIAG025</td><td style=\"border-left-width: 0px\">Pulmonary venous stenosis</td><td>ECHSA ne distingue pas congénital et acquis</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DIAG-2019-11</td><td style=\"border-left-width: 0px\">Pulmonary venous stenosis, Spontaneous</td><td>« spontanée » : ni strictement congénitale, ni post-opératoire</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0029</td><td style=\"border-left-width: 0px\">Anomalie congénitale d'une valve auriculoventriculaire ou d'un septum auriculoventriculaire</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0030</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Anomalie congénitale de la valve tricuspide</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DIAG040</td><td style=\"border-left-width: 0px\">Tricuspid valve, Other</td><td>catégorie « autre » de la valve tricuspide</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG039</td><td style=\"border-left-width: 0px\">Tricuspid regurgitation and tricuspid stenosis</td><td>IT et RT</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0031</td><td style=\"border-left-width: 0px\">Insuffisance tricuspide congénitale</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG037</td><td style=\"border-left-width: 0px\">Tricuspid regurgitation, non-Ebstein's related</td><td>IT non liée à une maladie d'Ebstein</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0032</td><td style=\"border-left-width: 0px\">Sténose congénitale de la valve tricuspide</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG038</td><td style=\"border-left-width: 0px\">Tricuspid stenosis</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0033</td><td style=\"border-left-width: 0px\">Dysplasie de la valve tricuspide</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">DIAG040</td><td style=\"border-left-width: 0px\">Tricuspid valve, Other</td><td>catégorie « autre »</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0034</td><td style=\"border-left-width: 0px\">Malformation d'Ebstein de la valve tricuspide</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG036</td><td style=\"border-left-width: 0px\">Ebstein's anomaly</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0035</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Anomalie congénitale de la valve mitrale</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DIAG068</td><td style=\"border-left-width: 0px\">Mitral valve, Other</td><td>catégorie « autre » de la valve mitrale</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG066</td><td style=\"border-left-width: 0px\">Mitral regurgitation and mitral stenosis</td><td>IM et RM</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0036</td><td style=\"border-left-width: 0px\">Insuffisance mitrale congénitale</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG067</td><td style=\"border-left-width: 0px\">Mitral regurgitation</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0037</td><td style=\"border-left-width: 0px\">Sténose valvulaire mitrale congénitale</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG062</td><td style=\"border-left-width: 0px\">Mitral stenosis, Valvar</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0038</td><td style=\"border-left-width: 0px\">Dysplasie de la valve mitrale</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">DIAG068</td><td style=\"border-left-width: 0px\">Mitral valve, Other</td><td>catégorie « autre »</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0039</td><td style=\"border-left-width: 0px\">Anomalie congénitale de l'appareil mitral sousvalvaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG063</td><td style=\"border-left-width: 0px\">Mitral stenosis, Subvalvar</td><td>seulement la sténose sous-valvulaire</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0040</td><td style=\"border-left-width: 0px\">Jonction auriculoventriculaire commune sans communication septale auriculoventriculaire</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0041</td><td style=\"border-left-width: 0px\">Jonction auriculoventriculaire commune avec communication septale auriculoventriculaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG010</td><td style=\"border-left-width: 0px\">AVC (AVSD), Complete (CAVSD)</td><td>forme complète seulement</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0042</td><td style=\"border-left-width: 0px\">Anomalie septale auriculoventriculaire avec communication au niveau auriculaire uniquement</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG012</td><td style=\"border-left-width: 0px\">AVC (AVSD), Partial (incomplete) (PAVSD) (ASD, primum)</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0043</td><td style=\"border-left-width: 0px\">Anomalie septale auriculoventriculaire avec communication au niveau ventriculaire uniquement</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DIAG011</td><td style=\"border-left-width: 0px\">AVC (AVSD), Intermediate (transitional)</td><td>ECHSA « intermédiaire (transitionnel) » suppose une communication auriculaire ; le concept n'a qu'une communication ventriculaire</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0044</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Anomalie septale auriculoventriculaire avec communication au niveau auriculaire et communication restrictive au niveau ventriculaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">DIAG010</td><td style=\"border-left-width: 0px\">AVC (AVSD), Complete (CAVSD)</td><td>le concept est la forme intermédiaire, pas la forme complète</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG011</td><td style=\"border-left-width: 0px\">AVC (AVSD), Intermediate (transitional)</td><td>ajout v6.1 : forme intermédiaire (transitionnelle) ; ajouté v6.1 — forme intermédiaire (transitionnelle) du canal atrioventriculaire, absente de la liste v6</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0045</td><td style=\"border-left-width: 0px\">Anomalie septale auriculoventriculaire avec communication au niveau auriculaire et communication non-restrictive au niveau ventriculaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG010</td><td style=\"border-left-width: 0px\">AVC (AVSD), Complete (CAVSD)</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0046</td><td style=\"border-left-width: 0px\">Communication septale auriculoventriculaire avec déséquilibre ventriculaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG078</td><td style=\"border-left-width: 0px\">Single ventricle, Unbalanced AV canal</td><td/></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0047</td><td style=\"border-left-width: 0px\">Anomalie septal auriculoventriculaire et tétralogie de Fallot</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG029</td><td style=\"border-left-width: 0px\">TOF, AVC (AVSD)</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0048</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Anomalie congénitale du ventricule ou du septum ventriculaire</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG121</td><td style=\"border-left-width: 0px\">Hypoplastic LV</td><td>sous-type</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG120</td><td style=\"border-left-width: 0px\">Hypoplastic RV</td><td>sous-type</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none; border-bottom-style: none\"/><td style=\"border-left-width: 0px; border-top-style: none; border-bottom-style: none\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG-2019-27</td><td style=\"border-left-width: 0px\">Diverticulum, Ventricular, Left</td><td>sous-type</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">DIAG-2019-28</td><td style=\"border-left-width: 0px\">Diverticulum, Ventricular, Right</td><td>sous-type</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0049</td><td style=\"border-left-width: 0px\">Obstruction congénitale de la voie de sortie du ventricule droit</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-DIAG-0050</td><td style=\"border-left-width: 0px\">Ventricule droit à double chambre</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG046</td><td style=\"border-left-width: 0px\">DCRV</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-DIAG-0051</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Tétralogie de Fallot</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">DIAG028</td><td style=\"border-left-width: 0px\">TOF</td><td/></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps