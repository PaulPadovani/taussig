     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4440" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Unifocalization MAPCA(s)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Anastomosis of aortopulmonary collateral arteries into the left, right, or main pulmonary artery or into a tube graft or other type of confluence. The unifocalization procedure may be done on or off bypass." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "status post" ]
