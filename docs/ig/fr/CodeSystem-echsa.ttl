     fhir:CodeSystem.concept.definition [ fhir:value "Code this factor if the patient has only one lung present at the time of OR Entry Date and Time." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
