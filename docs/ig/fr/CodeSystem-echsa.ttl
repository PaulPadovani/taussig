     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4260" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PAPVC repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "PAPVC repair revolves around whether an intracardiac baffle is created to redirect pulmonary venous return to the left atrium or if the anomalous pulmonary vein is translocated and connected to the left atrium directly. If there is an associated ASD and it is closed, that procedure should also be listed." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "status post" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "status post" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
