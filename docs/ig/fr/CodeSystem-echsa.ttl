     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP-2010-370" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Multi-System Organ Failure (MSOF) = Multi-Organ Dysfunction Syndrome (MODS)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Multi-System Organ Failure (MSOF) is a condition where more than one organ system has failed (for example, respiratory failure requiring mechanical ventilation combined with renal failure requiring dialysis).  Please code the individual organ system failures as well.  If MSOF is associated with sepsis as well, please also code: \"Sepsis, Multi-system Organ Failure\".  Multi-System Organ Failure (MSOF) is synonymous with Multi-Organ Dysfunction Syndrome (MODS)." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "complication" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Multiple" ]
     ], [
       fhir:index -1 ;
