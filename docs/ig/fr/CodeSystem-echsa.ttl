     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG166" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Pulmonary stenosis, Subvalvar" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Subvalvar (infundibular) pulmonary stenosis is a narrowing of the outflow tract of the right ventricle below the pulmonic valve. It may be due to a localized fibrous diaphragm just below the valve, an obstructing muscle bundle or to a long narrow fibromuscular channel." ] ;
     fhir:CodeSystem.concept.property [
