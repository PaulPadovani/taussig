       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG046" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DCRV" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "The double chambered right ventricle is characterized by a low infundibular (subvalvar) stenosis rather than the rare isolated infundibular stenosis that develops more superiorly in the infundibulum, and is often associated with one or several closing VSDs. In some cases, the VSD is already closed. The stenosis creates two chambers in the RV, one inferior including the inlet and trabecular portions of the RV and one superior including the infundibulum." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Right Heart Lesions" ]
     ], [
