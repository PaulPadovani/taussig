     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP2" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Cardiac arrest, Timing = Cardiac arrest (MI) during or following procedure (Perioperative/Periprocedural = Intraoperative/Intraprocedural and/or Postoperative/Postprocedural)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "A cardiac arrest is the cessation of effective cardiac mechanical function.  This complication should be selected if the cardiac arrest developed after OR Entry Date and Time." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "complication" ]
     ], [
       fhir:index -1 ;
