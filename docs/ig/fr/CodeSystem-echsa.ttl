     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG165" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Pulmonary artery, Discontinuous" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Indicate if the patient has the diagnosis of \"Pulmonary artery, Discontinuous\". Pulmonary artery, Discontinuous \" is defined as a congenital or acquired anomaly with discontinuity between the branch pulmonary arteries or between a branch pulmonary artery and the main pulmonary artery trunk." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
