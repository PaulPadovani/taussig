     fhir:CodeSystem.concept.display [ fhir:value "Other annular enlargement procedure" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Techniques included under this procedure code include those designed to effect aortic annular enlargement that are not included in other procedure codes. These include the Manougian and Nicks aortic annular enlargement procedures." ] ;
