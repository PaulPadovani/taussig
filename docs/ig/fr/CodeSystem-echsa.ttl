     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "GPRF-2010-250" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Diabetes mellitus, Insulin dependent" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Code this factor if the patient has evidence of insulin dependent diabetes mellitus at the time OR Entry Date and Time as manifested by the fact that the patient has the diagnosis of diabetes mellitus that is controlled with insulin." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
