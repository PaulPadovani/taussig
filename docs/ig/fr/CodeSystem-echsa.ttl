  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP22" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Bleeding, Requiring reoperation" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Postoperative/postprocedural bleeding requiring reoperation" ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
