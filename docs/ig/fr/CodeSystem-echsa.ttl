     fhir:CodeSystem.concept.display [ fhir:value "Mitral stenosis" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Stenotic lesions of the mitral valve not otherwise specified in the diagnosis definitions 650, 660, 670, and 680." ] ;
