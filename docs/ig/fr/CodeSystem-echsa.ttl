  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC54" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "DCRV repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Surgical repair of DCRV combines relief of the low infundibular stenosis (via muscle resection) and closure of a VSD when present. A ventriculotomy may be required and is repaired by patch enlargement of the infundibulum. VSD closure and patch enlargement of the infundibulum, if done, should be listed as separate procedure codes." ] ;
