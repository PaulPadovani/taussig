     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG128" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Pulmonary embolism" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "A pulmonary embolus is a blockage of an artery in the lungs by fat, air, clumped tumor cells, or a blood clot." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
