  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC73" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Aortic stenosis, Subvalvar, Repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Subvalvar aortic stenosis repair by a range of techniques including excision, excision and myotomy, excision and myomectomy, myotomy, myomectomy, initial placement of apical-aortic conduit (LV to aorta conduit replacement would be coded as conduit reoperation) , Vouhé aortoventriculoplasty (aortic annular incision at commissure of left and right coronary cusps is carried down to the septum and RV infundibulum; septal muscle is resected, incisions are closed, and the aortic annulus is reconstituted), or other aortoventriculoplasty techniques." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
