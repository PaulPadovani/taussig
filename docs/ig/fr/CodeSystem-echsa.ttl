     fhir:CodeSystem.concept.display [ fhir:value "AP window repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Repair of AP window using one- or twopatch technique with cardiopulmonary bypass; or, without cardiopulmonary bypass, using transcatheter device or surgical closure." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
