       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "GPRF-2010-350" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Coagulation disorder, Hypocoagulable state not secondary to medication (intrinsic hypocoagulable state)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Code this factor if the patient has evidence of a coagulopathy at the time OR Entry Date and Time as manifest by PT/PTT above normal, Thrombocytopenia <100,000,ot Fibrinogen split products positive (>10%) and the coagulopathy is NOT secondary to medications such as Heparin or Warfarin." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "gprf" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Hematological" ]
     ], [
       fhir:index -1 ;
