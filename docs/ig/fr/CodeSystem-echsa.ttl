       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-450" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "VACTERL-H syndrome (VATER association with hydrocephalus) (Briard-Evans syndrome)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "VACTERL-H association is also known as VATER association with hydrocephalus, Briard-Evans syndrome, David-O'Callaghan syndrome (autosomal recessive type), and Hunter-MacMurray syndrome (X-linked type) [mapped to 10q23.31 & Xp22.31].  VACTERL-H is an autosomal recessive condition; some X-linked cases have been reported.  VACTERL-H is a nonrandom association of defects, including Vertebral anomalies, Anal atresia, Cardiac malformations, TracheoEsophageal fistula, Renal anomalies, Limb anomalies and Hydrocephalus.  Diagnosis is made if 3/7 defects are present with hydrocephalus.  Cardiovascular abnormalities include VSD, TOF, TGA and PDA." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
       fhir:index -1 ;
