       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG041" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Pulmonary stenosis, Valvar" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Pulmonary stenosis, Valvar ranges from critical neonatal pulmonic valve stenosis with hypoplasia of the right ventricle to valvar pulmonary stenosis in the infant, child, or adult, usually better tolerated but potentially associated with infundibular stenosis. Pulmonary branch hypoplasia can be associated. Only 10% of neonates with Pulmonary stenosis, Valvar with intact ventricular septum have RV-to-coronary artery fistula(s). An RV dependent coronary artery circulation is present when coronary artery fistulas (coronary sinusoids) are associated with a proximal coronary artery stenosis; this occurs in only 2% of neonates with Pulmonary stenosis, Valvar with IVS." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
       fhir:index -1 ;
