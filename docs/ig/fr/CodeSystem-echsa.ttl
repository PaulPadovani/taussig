  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP18" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Pleural effusion, Requiring drainage" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Abnormal accumulation of fluid in the pleural space, Requiring drainage, By any technique.  If the pleural effusion is known to be a chylothorax, please only code \"Chylothorax \"." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
