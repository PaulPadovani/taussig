       fhir:CodeSystem.concept.property.valueString [ fhir:value "Single Ventricle" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "patient" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG075" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Single ventricle, DIRV" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Single morphologically right ventricle (more heavily trabeculated, generally have chordal attachments of AV valve to the septal surfaces) that receives both atrioventricular valves." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
