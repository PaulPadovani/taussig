     fhir:CodeSystem.concept.display [ fhir:value "Arrhythmia, Heart block" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Atrioventricular block may be congenital or acquired, and may be of varying degree (first, second, or third degree)." ] ;
     fhir:CodeSystem.concept.property [
