  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG119" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Aneurysm, Other" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "A localized dilation or enlargement of a cardiac vessel or chamber not coded in specific fields available for aortic aneurysm, sinus of Valsalva aneurysm, coronary artery aneurysm, right ventricular aneurysm, left ventricular aneurysm, or pulmonary artery aneurysm." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
