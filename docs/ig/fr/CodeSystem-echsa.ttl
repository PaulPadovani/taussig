     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG037" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Tricuspid regurgitation, non-Ebstein's related" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Non-Ebstein's tricuspid regurgitation may be due to congenital factors (primary annular dilation, prolapse, leaflet underdevelopment, absent papillary muscle/chordae) or acquired (post cardiac surgery or secondary to rheumatic fever, endocarditis, trauma, tumor, cardiomyopathy, iatrogenic or other causes)." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
