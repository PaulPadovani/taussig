     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4250" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Valve replacement, Truncal valve" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Replacement of the truncal valve with a prosthetic valve." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "status post" ]
