     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA10" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Williams syndrome (Williams-Beuren syndrome)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Williams syndrome, or Williams-Beuren syndrome, is an autosomal dominant condition [mapped to 7q11.23].  Incidence is 1:7500 births.  Williams syndrome was initially described by Williams and colleagues in four unrelated children with mental retardation, an unusual facial appearance, and supravalvar stenosis.  Cardiovascular abnormalities occur in at least 50% of cases and include supravalvar aortic stenosis, bicuspid aortic valve, mitral valve prolapse, mitral regurgitation, coronary artery stenosis, pulmonary valve stenosis, ASD, VSD and peripheral pulmonary artery stenosis.  Supravalvar aortic stenosis is the most frequent single defect, but any of the systemic or pulmonary arteries can be affected." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Syndrome" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "patient" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA17" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Marfan syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Marfan syndrome is an autosomal dominant condition [mapped to 15q21.1].  Incidence is 1:5000 births.  Marfan syndrome is the most common connective tissue disorder, and is associated with the risk of sudden cardiac death.  Cardiovascular abnormalities include aortic root dilation, aortic dissection and rupture, aortic regurgitation, ascending aortic aneurysm, mitral valve prolapse, mitral regurgitation, tricuspid valve prolapse, premature calcification of the mitral annulus, pulmonary artery dilatation and CHF." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Syndrome" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
