     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-110" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Deletion 10p syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Deletions on the short arm of chromosome 10 are associated with septal defects, particularly ASDs, and DiGeorge/velocardiofacial 2 syndrome." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
