       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC83" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "HLHS biventricular repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Performed in patients who have small but adequately sized ventricles to support systemic circulation. These patients usually have small, but not stenotic, aortic and/or mitral valves. Primary biventricular repair has consisted of extensive aortic arch and ascending aorta enlargement with a patch, closure of interventricular and interatrial communications, and conservative approach for left ventricular outflow tract obstruction (which may include mitral stenosis at any level, subaortic stenosis, aortic stenosis, aortic arch hypoplasia, coarctation, or interrupted aortic arch). Concurrent operations (e.g., coarctation repair, aortic valve repair or replacement, etc.) can be coded separately within the database." ] ;
