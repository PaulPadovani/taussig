     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4240" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Valvuloplasty, Truncal valve" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Truncal valve repair, any type." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
