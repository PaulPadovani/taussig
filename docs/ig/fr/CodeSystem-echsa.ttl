     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC35" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TOF repair, RV-PA conduit" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Tetralogy of Fallot repair (assumes VSD closure and relief of pulmonary stenosis at one or more levels), with placement of a right ventricle-to-pulmonary artery conduit. In this procedure the major components of pulmonary stenosis are relieved with placement of the RV-PA conduit." ] ;
     fhir:CodeSystem.concept.property [
