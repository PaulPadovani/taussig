     fhir:CodeSystem.concept.definition [ fhir:value "Sternum was left open postoperatively without preoperative plans to leave the sternum open postoperatively (i.e. unplanned).  The goal is for delayed sternotomy closure." ] ;
     fhir:CodeSystem.concept.property [
