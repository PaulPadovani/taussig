     fhir:CodeSystem.concept.definition [ fhir:value "Spinal cord injury (ROOT Definition) + With a persisting neurologic deficit present at hospital discharge. {\"Spinal cord injury\" ROOT Definition = Newly acquired or newly recognized deficit of spinal cord function indicated by physical exam findings, imaging studies, or both.}" ] ;
