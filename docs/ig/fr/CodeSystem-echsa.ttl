       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG039" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Tricuspid regurgitation and tricuspid stenosis" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Tricuspid regurgitation present with tricuspid stenosis may be due to congenital factors or acquired." ] ;
     fhir:CodeSystem.concept.property [
