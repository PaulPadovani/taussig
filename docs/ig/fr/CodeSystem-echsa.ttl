  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4530" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PA, reconstruction (plasty), Main (trunk)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Reconstruction of the main pulmonary artery trunk commonly using patch material. If balloon angioplasty is performed or a stent is placed in the main pulmonary artery intraoperatively, this code may be used in addition to the balloon dilation or stent placement code. If MPA reconstruction is performed with PA debanding, both codes should be listed." ] ;
