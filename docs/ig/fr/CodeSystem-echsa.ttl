       fhir:CodeSystem.concept.property.valueCode [ fhir:value "operation" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "GPRF-2010-320" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Necrotizing entero-colitis, Treated medically" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Necrotizing enterocolitis (NEC) ROOT Definition = Necrotizing enterocolitis is defined as an acute reduction in the supply of oxygenated blood to the small intestine or large intestine, typically resulting in acidosis, abdominal distention, pneumatosis, and/or intestinal perforation, that prompts initiation of antibiotics or exploratory laparotomy.  Select this factor if NEC is present during the same hospitalization as this operation and was managed without surgery to treat the NEC." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "gprf" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Gastrointestinal" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "operation" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "GPRF-2010-330" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Necrotizing entero-colitis, Treated surgically" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Necrotizing enterocolitis (NEC) ROOT Definition = Necrotizing enterocolitis is defined as an acute reduction in the supply of oxygenated blood to the small intestine or large intestine, typically resulting in acidosis, abdominal distention, pneumatosis, and/or intestinal perforation, that prompts initiation of antibiotics or exploratory laparotomy.  Select this factor if NEC is present during the same hospitalization as this operation and was managed with surgery to treat the NEC." ] ;
     fhir:CodeSystem.concept.property [
