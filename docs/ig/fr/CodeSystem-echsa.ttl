       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-410" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Situs inversus" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Situs inversus is defined as an abnormality where the internal thoraco-abdominal organs demonstrate mirror-imaged atrial arrangement across the left-right axis of the body." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
