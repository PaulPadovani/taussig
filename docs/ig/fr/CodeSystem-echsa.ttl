     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG122" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Mediastinitis" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Inflammation/infection of the mediastinum, the cavity between the lungs which holds the heart, great vessels, trachea, esophagus, thymus, and connective tissues. In the United States mediastinits occurs most commonly following chest surgery." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
