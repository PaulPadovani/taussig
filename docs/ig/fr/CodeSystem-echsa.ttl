     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA5" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "22q11 deletion" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Deletions or mutations  involving the long arm of chromosome 22 (critical region 22q11.2) are associated with the DiGeorge sequence, velocardiofacial syndrome, conotruncal face anomaly syndrome, CATCH 22, and some isolated conotruncal malformations." ] ;
