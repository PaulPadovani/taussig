  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4230" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Truncus arteriosus repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Truncus arteriosus repair that most frequently includes patch VSD closure and placement of a conduit from RV to PA. In some cases, a conduit is not placed but an RV to PA connection is made by direct association. Very rarely, there is no VSD to be closed. Truncal valve repair or replacement should be coded separately (Valvuloplasty, Truncal valve; Valve replacement, Truncal valve), as would be the case as well with associated arch anomalies requiring repair (e.g., Interrupted aortic arch repair)." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
