       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC44" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Valve replacement, Tricuspid (TVR)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Replacement of the tricuspid valve with a prosthetic valve." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
