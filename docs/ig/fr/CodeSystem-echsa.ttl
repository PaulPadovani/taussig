     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-90" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Costello syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Costello syndrome is an autosomal dominant condition [mapped to 12p12.1 & 11p15.5]; some sporadic cases have been reported.  Incidence is 1:1,000,000 births.  Cardiovascular abnormalities include ASD, VSD, pulmonic stenosis, mitral valve prolapse, hypertrophic cardiomyopathy and arrhythmias." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
