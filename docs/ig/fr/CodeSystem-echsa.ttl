  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-120" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Deletion 8p syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Deletions on the short arm of chromosome 8 are associated with ASD, AVSC, conotruncal abnormalities, pulmonic valve stenosis and Tetralogy of Fallot." ] ;
     fhir:CodeSystem.concept.property [
