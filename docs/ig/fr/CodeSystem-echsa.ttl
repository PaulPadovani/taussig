     fhir:CodeSystem.concept.code [ fhir:value "GPRF-2010-340" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Coagulation disorder, Hypercoagulable state" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Code this factor if the patient has evidence of a hypercoagulable state at the time OR Entry Date and Time." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "gprf" ]
