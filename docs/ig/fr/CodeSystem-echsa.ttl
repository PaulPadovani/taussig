     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-300" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Marfan-like syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Marfan-like syndrome is a connective tissue disorder, resembling Marfan syndrome." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
