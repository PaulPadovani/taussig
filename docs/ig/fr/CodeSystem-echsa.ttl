  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA7" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Fetal rubella syndrome (Congenital rubella syndrome)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Indicate whether the patient has a history of maternal rubella virus infection during first trimester of pregnancy.  Fetal rubella syndrome is associated with PDA, peripheral pulmonary stenosis, fibromuscular and intimal proliferation of medium and large arteries, VSD and ASD." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
