     fhir:CodeSystem.concept.display [ fhir:value "Tricuspid valve, Other" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Tricuspid valve pathology not otherwise specified in diagnosis definitions 370, 380, 390 and 400." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
