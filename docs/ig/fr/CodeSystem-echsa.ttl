     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC42" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Occlusion MAPCA(s)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Occlusion, or closing off, of MAPCAs. This may be done with a transcatheter occluding device, usually a coil, or by surgical techniques." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
