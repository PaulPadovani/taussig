     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-170" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Goldenhar syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Goldenhar syndrome, also known as hemifacial microsomia, oculoauriculovertebral dysplasia or spectrum, and facioauriculovertebral sequence, is an autosomal dominant condition [mapped to 14q32].  Incidence is 1:3000-5000 births.  Cardiovascular abnormalities include VSD, PDA, TOF and coarctation" ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Syndrome" ]
     ], [
       fhir:index -1 ;
