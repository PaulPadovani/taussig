     fhir:CodeSystem.concept.display [ fhir:value "Intraoperative death or intraprocedural death" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Patient died in the operating room or procedure room (such as catheterization laboratory or hybrid suite) during the operation or procedure that is being analyzed." ] ;
