     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-80" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Cornelia de Lange syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Cornelia de Lange syndrome (CDLS), also known as de Lange or Brachmann-de Lange syndrome, is an autosomal dominant condition [mapped to 5p13.1, Xp11.22-11.21 & 10q25]; some X-linked and sporadic cases have been reported.  Incidence is 1:10,000-30,000 births.  Cardiovascular abnormalities in 25% of cases most commonly include VSD and ASD." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
