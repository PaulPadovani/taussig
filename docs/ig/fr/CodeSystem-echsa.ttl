     fhir:CodeSystem.concept.display [ fhir:value "Pulmonary artery origin from ascending aorta (hemitruncus) repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Repair of pulmonary artery origin from the ascending aorta by direct reimplantation, autogenous flap, or conduit, with or without use of cardiopulmonary bypass." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
