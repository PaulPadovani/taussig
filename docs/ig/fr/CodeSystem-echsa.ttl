  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP-2010-420" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Stroke" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "\"Stroke\" ROOT Definition = A stroke is any confirmed neurological deficit of abrupt onset caused by a disturbance in blood flow to the brain, when the neurologic deficit does not resolve within 24 hours." ] ;
