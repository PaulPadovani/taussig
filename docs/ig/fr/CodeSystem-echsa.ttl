       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4390" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TOF - AVC (AVSD) repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Tetralogy of Fallot repair (assumes VSD closure and relief of pulmonary stenosis at one or more levels), with repair of associated AV canal defect.  Repair of associated atrial septal defect or atrioventricular valve repair(s) should be listed as additional or secondary procedures under the primary TOF-AVC procedure." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "status post" ]
     ], [
