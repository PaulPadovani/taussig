       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-420" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Smith-Lemli-Opitz syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Smith-Lemli-Opitz syndrome is an autosomal recessive condition [mapped to 11q12-q13].  Incidence is 1:20,000-40,000 births.  Cardiovascular abnormalities include VSD, ASD, coarctation of the aorta, and PDA." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
       fhir:index -1 ;
