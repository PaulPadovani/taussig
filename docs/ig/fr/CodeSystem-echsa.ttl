  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "GPRF15" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Seizure within 48 hours prior to surgery" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "\"Seizure\" ROOT Definition = A seizure is defined as the clinical and/or electroencephalographic recognition of epileptiform activity.  Select this preoperative factor for any prior seizure during the 48 hours prior to surgery." ] ;
