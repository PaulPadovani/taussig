       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG154" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Congenitally corrected TGA, IVS-LVOTO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Indicate if the patient has the diagnosis of \"Congenitally corrected TGA, IVS-LVOTO\". \"Congenitally corrected TGA, IVS-LVOTO\" is \"Congenitally corrected transposition with an intact ventricular septum and left ventricular outflow tract obstruction\", in other words, \" Congenitally corrected transposition with left ventricular outflow tract obstruction and no VSD\". (Congenitally corrected transposition is synonymous with the terms \" corrected transposition\" and \"discordant atrioventricular connections with discordant ventriculo-arterial connections\", and is defined as a spectrum of cardiac malformations where the atrial chambers are joined to morphologically inappropriate ventricles, and the ventricles then support morphologically inappropriate arterial trunks [1]. [1] Jacobs JP, Franklin RCG, Wilkinson JL, Cochrane AD, Karl TR, Aiello VD, Béland MJ, Colan SD, Elliott, MJ, Gaynor JW, Krogmann ON, Kurosawa H, Maruszewski B, Stellin G, Tchervenkov CI, Weinberg PM. The nomenclature, definition and classification of discordant atrioventricular connections. In 2006 Supplement to Cardiology in the Young: Controversies and Challenges of the Atrioventricular Junctions and Other Challenges Facing Paediatric Cardiovascular Practitioners and their Patients, Jacobs JP, Wernovsky G, Gaynor JW, and Anderson RH (editors). Cardiology in the Young, Volume 16 (Supplement 3): 72-84, September 2006.)" ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
