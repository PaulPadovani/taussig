       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC30" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PAPVC repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "PAPVC repair revolves around whether an intracardiac baffle is created to redirect pulmonary venous return to the left atrium or if the anomalous pulmonary vein is translocated and connected to the left atrium directly. If there is an associated ASD and it is closed, that procedure should also be listed." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "procedure" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Pulmonary Venous Anomalies" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "operation" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC31" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PAPVC, Scimitar, Repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "In scimitar syndrome, PAPVC repair also revolves around whether an intracardiac baffle is created to redirect pulmonary venous return to the left atrium or if the anomalous pulmonary vein is translocated and connected to the left atrium directly. If there is an associated ASD and it is closed, that procedure should also be listed. Occasionally an ASD is created; this procedure also must be listed separately. Concomitant thoracic procedures (e.g., lobectomy, pneumonectomy) should also be included in the procedures listing." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "procedure" ]
     ], [
