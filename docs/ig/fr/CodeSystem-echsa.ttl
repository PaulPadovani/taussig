       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-440" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "VACTERL syndrome (VACTER/VATER/VATERR syndrome)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "VACTERL syndrome is a nonrandom association of defects, including Vertebral anomalies, Anal atresia, Cardiovascular anomalies, Tracheoesophageal fistula, Esophageal atresia, Renal and/or Radial anomalies, and Limb anomalies.  Diagnosis is made if 3/7 defects are present.  Incidence is 1:6000 births.  Cardiovascular malformations include VSD, TOF, TGA and PDA." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Syndrome" ]
     ], [
       fhir:index -1 ;
