     fhir:CodeSystem.concept.definition [ fhir:value "Any unplanned readmission to the hospital within 30 days of surgery or intervention" ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
