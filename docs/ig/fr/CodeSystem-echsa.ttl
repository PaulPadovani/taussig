  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-510" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Other syndromic abnormality(ies)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "This patient has other syndromic abnormality(ies) that are not on this list." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
