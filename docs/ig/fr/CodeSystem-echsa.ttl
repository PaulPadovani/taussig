     fhir:CodeSystem.concept.display [ fhir:value "LV to aorta tunnel repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "LV to aorta tunnel repair can be accomplished by suture, patch, or both, and may require reimplantation of the right coronary artery. Associated coronary artery procedures should be coded separately from the LV to aorta tunnel repair." ] ;
