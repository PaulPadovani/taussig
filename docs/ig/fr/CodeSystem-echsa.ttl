  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP6" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Arrhythmia" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "\"Arrhythmia\" ROOT Definition = Any cardiac rhythm other than Normal Sinus Rhythm (non-NSR).  If pacemaker is required, also code \"Arrhythmia necessitating pacemaker\".  The definition of arrhythmia from The World Health Organization and The International Society of Cardiology Task Force is as follows:  An arrhythmia is defined as \"any cardiac rhythm other than the normal sinus rhythm. Such a rhythm may be either of sinus or ectopic origin, and either regular or irregular. An arrhythmia may be due to a disturbance in impulse formation or conduction, or both\"." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "complication" ]
     ], [
