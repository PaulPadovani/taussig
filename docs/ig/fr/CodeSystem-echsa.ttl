     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP-2010-102" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Sternum left open, Planned" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Sternum was left open postoperatively with preoperative plans to leave the sternum open postoperatively (i.e. planned).  The goal is for delayed sternotomy closure." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
