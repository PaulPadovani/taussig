       fhir:CodeSystem.concept.property.valueCode [ fhir:value "patient" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG127" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Pulmonary AV fistula" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "An abnormal intrapulmonary connection (fistula) between an artery and vein that occurs in the blood vessels of the lungs. Pulmonary AV fistulas may be seen in association with congenital heart defects; the associated cardiac defect should be coded as well." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
