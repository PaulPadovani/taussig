     fhir:CodeSystem.concept.definition [ fhir:value "Pericardial drainage can include a range of therapies including, but not limited to: pericardiocentesis, pericardiostomy tube placement, pericardial window creation, and open pericardial drainage (pericardiotomy)." ] ;
