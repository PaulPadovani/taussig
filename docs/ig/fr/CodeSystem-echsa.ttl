     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4550" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PA, reconstruction (plasty), Branch, Peripheral (at or beyond the hilar bifurcation)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Reconstruction of the peripheral right or left branch (or both right and left) pulmonary arteries (at or beyond the hilar bifurcation) commonly using patch material. If balloon angioplasty is performed or a stent is placed in the right or left (or both) peripheral pulmonary artery intraoperatively, this code may be used in addition to the balloon dilation or stent placement code." ] ;
