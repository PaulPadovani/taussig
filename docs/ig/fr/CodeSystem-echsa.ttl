     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4280" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TAPVC repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Repair of TAPVC, any type. Issues surrounding TAPVC repair involve how the main pulmonary venous confluence anastomosis is fashioned, whether an associated ASD is closed or left open or enlarged (ASD closure and enlargement may be listed separately), and whether, particularly in mixed type TAPVC repair, an additional anomalous pulmonary vein is repaired surgically." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "status post" ]
     ], [
       fhir:index -1 ;
