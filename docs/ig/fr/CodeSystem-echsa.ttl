  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC49" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "1 1/2 ventricular repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Partial biventricular repair; includes intracardiac repair with bidirectional cavopulmonary anastomosis to volume unload a small ventricle or poorly functioning ventricle." ] ;
