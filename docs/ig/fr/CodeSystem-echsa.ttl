  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG152" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Cardiomyopathy, End-stage congenital heart disease" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Myocardial abnormality in which there is systolic and/or diastolic dysfunction in the presence of structural congenital heart disease without any (or any further) surgically correctable lesions." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
