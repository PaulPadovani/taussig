     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "GPRF-2010-260" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Diabetes mellitus, Non-insulin dependent" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Code this factor if the patient has evidence of non-insulin dependent diabetes mellitus at the time OR Entry Date and Time as manifested by the fact that the patient has the diagnosis of diabetes mellitus that is controlled with dietary modification with or without oral medications (oral antihyperglycemic agents)." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "gprf" ]
     ], [
