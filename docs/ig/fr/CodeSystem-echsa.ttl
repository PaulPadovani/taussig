       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG168" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "VSD + Aortic arch hypoplasia" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "A ventricular septal defect, any type, associated with hypoplasia of the aortic arch. (See diagnosis definition 1000 for a definition of hypoplasia of the aortic arch.)" ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
