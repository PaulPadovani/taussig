     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-60" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Cat-eye syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "The cat-eye syndrome, or Schmid-Fraccaro syndrome, is an autosomal dominant condition [mapped to 22q11], associated with coloboma of the iris.  Incidence is 1:50,000-150,000 births.  The classic pattern of malformations includes mild mental deficiency, hypertelorism, down-slanting palpebral fissures, iris coloboma, pre-auricular pits or tags, and anal and renal malformations.  Cardiovascular abnormalities in 40% of cases include TAPVC, ASD, VSD, persistent left superior vena cava, TOF, interruption of the inferior vena cava, and tricuspid atresia." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
