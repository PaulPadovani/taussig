     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4430" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Pulmonary atresia - VSD - MAPCA (pseudotruncus) repair" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "In the presence of MAPCAs, this code implies implies pulmonary unifocalization (multi- or single-stage), repair of VSD (may be intraventricular tunnel or flat patch VSD closure), and placement of an RV-PA conduit." ] ;
     fhir:CodeSystem.concept.property [
