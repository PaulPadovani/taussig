       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP-2010-255" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Wound dehiscence (sterile), Median sternotomy" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Wound dehiscence (sterile) (ROOT Definition) + Location = Median sternotomy" ] ;
