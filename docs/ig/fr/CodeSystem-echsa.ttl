       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "SP-2010-4310" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Atrial baffle procedure (non-Mustard, non- Senning)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "The atrial baffle procedure code is used primarily for repair of systemic venous anomalies, as in redirection of left superior vena cava drainage to the right atrium." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "status post" ]
     ], [
