     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP13" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Pulmonary hypertensive crisis (PA pressure > systemic pressure)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "An acute state of inadequate systemic perfusion associated with pulmonary hypertension, when the pulmonary arterial pressure is greater than the systemic arterial pressure." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "complication" ]
     ], [
