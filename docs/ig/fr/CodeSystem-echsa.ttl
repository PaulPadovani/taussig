  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG001" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "PFO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Small interatrial communication in the region of the foramen ovale characterized by no deficiency of the septum primum and a normal limbus with no deficiency of the septum secundum." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
