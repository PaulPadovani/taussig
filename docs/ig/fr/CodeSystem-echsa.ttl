     fhir:CodeSystem.concept.display [ fhir:value "Gastrostomy present" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Code this factor if the patient has a gastrostomy present at the time of OR Entry Date and Time." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "gprf" ]
     ], [
