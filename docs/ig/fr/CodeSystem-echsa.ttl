  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "GPRF-2010-200" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Cardio-pulmonary resuscitation" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Chest compression with medications within 48 hours prior to surgery.  Select this factor if chest compression took place during the 48 hours prior to OR Entry Date and Time, or at the time of OR Entry Date and Time." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
