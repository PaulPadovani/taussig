     fhir:CodeSystem.concept.display [ fhir:value "Valve replacement, Tricuspid (TVR)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Replacement of the tricuspid valve with a prosthetic valve." ] ;
