     fhir:CodeSystem.concept.display [ fhir:value "ASD repair, Patch" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Patch closure (using any type of patch material) of secundum, coronary sinus, or sinus venosus ASD." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
