       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP-2010-24" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Unplanned interventional cardiovascular catheterization procedure during the postoperative or postprocedural time period" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Any unplanned interventional cardiovascular catheterization procedure occurring (1) within 30 days after surgery or intervention in or out of the hospital, or (2) after 30 days during the same hospitalization subsequent to the operation or intervention." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
