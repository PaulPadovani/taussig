     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG163" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Mediastinal disease" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Any disease of the mediastinum awaiting final benign/malignant pathology determination." ] ;
