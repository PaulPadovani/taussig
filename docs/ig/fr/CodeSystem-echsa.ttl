     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG074" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Single ventricle, DILV" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Single morphologically left ventricle (smooth internal walls, lack chordal attachments of AV valves to the rudimentary septal surface) that receives both atrioventricular valves." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
