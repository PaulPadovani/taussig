  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-100" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Cri-du-chat syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Cri-du-chat (cat cry), or LeJeune syndrome, is a chromosome deletion syndrome [mapped to 5p15.2].  Incidence is 1:20,000-50,000 births.  Cri-du-chat refers to the distinctive cry of children with this disorder, caused by abnormal larynx development.  Cardiovascular abnormalities in 30% of cases most commonly include VSD and ASD.  Rare defects include TOF and AVSD." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
