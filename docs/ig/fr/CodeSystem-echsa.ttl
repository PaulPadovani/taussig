       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP17" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Pneumothorax, Requiring intervention" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "A collection of gas in the pleural space resulting in collapse of some or all of the lung on the affected side, requiring intervention." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "complication" ]
     ], [
