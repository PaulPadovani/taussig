       fhir:CodeSystem.concept.property.valueString [ fhir:value "Right Heart Lesions" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "operation" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC34" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "TOF repair, Ventriculotomy, Transanular patch" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Tetralogy of Fallot repair (assumes VSD closure and relief of pulmonary stenosis at one or more levels), with use of a ventriculotomy incision and placement of a trans-pulmonary annulus patch. If the main pulmonary artery incision is extended proximally through the pulmonary annulus, this must be considered \"transannular\" and thus a ventricular incision, though the length of the incision onto the ventricle itself may be minimal." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
