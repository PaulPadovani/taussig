     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA2" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Heterotaxy syndrome, Polysplenia syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "\"Polysplenia syndrome\" can be defined as a subset of heterotaxy with components of bilateral left-sidedness, usually associated with multiple spleens." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
