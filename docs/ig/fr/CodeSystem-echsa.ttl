  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "PROC107" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Arterial switch operation (ASO)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Arterial switch operation is used for repair of transposition of the great arteries (TGA). The pulmonary artery and aorta are transected and translocated so that the pulmonary artery arises from the right ventricle and the aorta from the left ventricle. Coronary artery transfer is also accomplished." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
