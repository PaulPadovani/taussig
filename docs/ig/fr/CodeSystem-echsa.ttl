  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG118" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Aneurysm, Pulmonary artery" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "An aneurysm of the pulmonary artery is defined as a localized dilation or enlargement of the pulmonary artery trunk and its central branches (right and left pulmonary artery)." ] ;
     fhir:CodeSystem.concept.property [
