     fhir:CodeSystem.concept.definition [ fhir:value "Any additional unplanned non-cardiac operation occurring (1) within 30 days after surgery or intervention in or out of the hospital, or (2) after 30 days during the same hospitalization subsequent to the operation or intervention." ] ;
