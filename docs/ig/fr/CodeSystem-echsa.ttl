     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG005" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ASD, Common atrium (single atrium)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Complete absence of the interatrial septum. \"Single atrium\" is applied to defects with no associated malformation of the atrioventricular valves. \"Common atrium\" is applied to defects with associated malformation of the atrioventricular valves." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Septal Defects" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
