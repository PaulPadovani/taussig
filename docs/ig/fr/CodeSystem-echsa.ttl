     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG076" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Single ventricle, Mitral atresia" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Single ventricle anomalies with mitral atresia. May also be associated with double outlet right ventricle, congenitally corrected transposition, pulmonary atresia, or pulmonary stenosis." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
