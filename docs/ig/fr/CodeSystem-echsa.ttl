     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "GPRF1" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Preoperative/Preprocedural mechanical circulatory support (IABP, VAD, ECMO, or CPS)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Code this factor if the patient is supported with mechanical support, of any type (IABP, VAD, ECMO, or CPS), for resuscitation/CPR or support, at the time of OR Entry Date and Time." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
