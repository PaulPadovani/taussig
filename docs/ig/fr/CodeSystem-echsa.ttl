     fhir:CodeSystem.concept.display [ fhir:value "Ross-Konno procedure" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Relief of left ventricular outflow tract obstruction associated with aortic annular hypoplasia, aortic valvar stenosis and/or aortic valvar insufficiency via Konno aortoventriculoplasty using a pulmonary autograft root for the aortic root replacement." ] ;
