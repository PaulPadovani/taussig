     fhir:CodeSystem.concept.code [ fhir:value "PROC55" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Conduit reoperation" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Conduit reoperation is the code to be used in the event of conduit failure, in whatever position (LV to aorta, LV to PA, RA to RV, RV to aorta, RV to PA, etc.), and from whatever cause (somatic growth, stenosis, insufficiency, infection, etc)." ] ;
