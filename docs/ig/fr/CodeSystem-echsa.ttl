     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-490" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Wolf-Hirschhorn syndrome" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Wolf-Hirschhorn syndrome is a chromosome deletion syndrome [mapped to 4p16.3].  Incidence is 1:96,000 births.  Affected individuals have a 35% risk of mortality prior to age 2.  Cardiovascular abnormalities include ASD and VSD." ] ;
     fhir:CodeSystem.concept.property [
