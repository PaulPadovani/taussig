       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP-2010-160" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Postoperative/Postprocedural respiratory insufficiency requiring reintubation" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Reintubation required after initial extubation.  In other words, the need to reinstitute postoperative or postprocedural mechanical ventilation after a planned extubation and prior to discharge, or after a planned extubation and after discharge but within 30 days of surgery.  The intent of this field is to capture Postoperative/Postprocedural respiratory insufficiency requiring reintubation.  It is not intended to capture situations where a patient may undergo elective intubations for other additional operations or procedures (including percutaneous endoscopic gastrostomy [PEG], tube insertions, catheter placement, cardiac catheterizations, etc.).  However, these elective intubations and extubations are included and counted when determining \"Final Extubation Date and Time\"." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "complication" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Pulmonary" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "operation" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "ver2010" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP-2010-22" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Unplanned cardiac reoperation during the postoperative or postprocedural time period, exclusive of reoperation for bleeding" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Any additional unplanned cardiac operation occurring  (1) within 30 days after surgery or intervention in or out of the hospital, or (2) after 30 days during the same hospitalization subsequent to the operation or intervention.  A cardiac operation is defined as any operation that is of the operation type of \"CPB\" or \"No CPB Cardiovascular\".  The following operations will always be coded as \"Planned Reoperation\":  (1) Delayed Sternal Closure, (2) ECMO Decannulation, (3) VAD Decannulation, (4) Removal of Broviac catheter.  The following operations will always be coded as \"Unplanned Reoperation\":  (1) Reoperation for bleeding, (2) Reoperation for infection, (3) Reoperation for hemodynamic instability, (4) Reoperation for initiation of ECMO or VAD, (5) Reoperation for residual or recurrent lesion." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "complication" ]
     ], [
