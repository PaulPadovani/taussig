       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "NCA-2010-S-320" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Mucopolysaccharidosis type IH/S (Hurler-Scheie syndrome)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Hurler-Scheie syndrome, also known as mucopolysaccharidosis type IH/S (MPS IH/S), is an autosomal recessive disorder [mapped to 4p16.3].  Incidence is 1:500,000 births.  MPS is a lysosomal storage disease.  Onset of symptoms occurs between ages 3 and 8 years.  Survival to adulthood is typical.  Cardiovascular abnormalities include mitral valve anomalies." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "nca" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Syndrome" ]
     ], [
