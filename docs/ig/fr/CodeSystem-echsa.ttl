       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "CP14" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Postoperative/Postprocedural respiratory insufficiency requiring mechanical ventilatory support > 7 days" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Respiratory Insufficiency requiring mechanical ventilatory support from surgery or procedure to greater than 7 days postoperatively/postprocedurally.  In other words, the inability of the patient to exchange oxygen and carbon dioxide in sufficient quantities to avoid unacceptable hypercarbia, hypoxemia, or both, without mechanical ventilatory support for greater than 7 days during the postoperative or postprocedural period.  The patient therefore does utilize mechanical ventilatory support for greater than 7 days during the postoperative or postprocedural period." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "complication" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Pulmonary" ]
     ], [
