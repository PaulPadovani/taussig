     ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "DIAG123" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Endocarditis" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "An infection of the endocardial surface of the heart, which may involve one or more heart valves (native or prosthetic) or septal defects or prosthetic patch material placed at previous surgery." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "class" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "diagnosis" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "group" ] ;
       fhir:CodeSystem.concept.property.valueString [ fhir:value "Miscellaneous, Other" ]
     ], [
       fhir:index -1 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "context" ] ;
       fhir:CodeSystem.concept.property.valueCode [ fhir:value "patient" ]
     ], [
