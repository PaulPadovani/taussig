  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Narratif généré : Observation ex-taussig-clinical-measurement</b></p><a name=\"ex-taussig-clinical-measurement\"> </a><a name=\"hcex-taussig-clinical-measurement\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profil: <a href=\"StructureDefinition-taussig-clinical-measurement.html\">TAUSSIG — Mesure clinique (delta pre/post)</a></p><p style=\"margin-bottom: 0px\">Balise: </p></div><p><b>Phase procédurale (mesure)</b>: baseline</p><p><b>Condition de mesure</b>: resting</p><p><b>Dérivation de la mesure</b>: measured</p><p><b>partOf</b>: <a href=\"Procedure-ex-taussig-catheterization.html\">Procedure Cathétérisme cardiaque diagnostique : recueil des données hémodynamiques</a></p><p><b>status</b>: Unknown</p><p><b>code</b>: <span title=\"Codes :{https://taussig/fhir/CodeSystem/measurement-property pressure_systolic}\">Pression systolique</span></p><p><b>subject</b>: <a href=\"Patient-ex-taussig-patient.html\">Patient fictif — exemple technique Unknown, Date de Naissance :2020-01-01</a></p><p><b>effective</b>: 2026-01-01</p><p><b>value</b>: 20 mmHg<span style=\"background: LightGoldenRodYellow\"> (Détails : code UCUMmm[Hg] = 'mm[Hg]')</span></p><p><b>method</b>: <span title=\"Codes :{https://taussig/fhir/CodeSystem/measurement-modality catheterization}\">Cathétérisme</span></p></div>"
