     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Narratif généré : CarteDeConcepts taussig-adverse-event-to-echsa</b></p><a name=\"taussig-adverse-event-to-echsa\"> </a><a name=\"hctaussig-adverse-event-to-echsa\"> </a><p>Mapping de <a href=\"ValueSet-taussig-adverse-event.html\">TAUSSIG — Liste des complications</a> vers (non spécifié)</p><br/><p>Mapping de <a href=\"CodeSystem-taussig-adverse-event.html\">TAUSSIG — Complications</a> to <a href=\"CodeSystem-echsa.html\">TAUSSIG — ECHSA (nomenclature EACTS-ECHSA, représentation POC)</a></p><table class=\"grid\"><tr><td colspan=\"2\"><b>Détails du concept source</b></td><td><b>relation</b></td><td colspan=\"2\"><b>Détails du concept cible</b></td><td><b>Commentaire</b></td></tr><tr><td colspan=\"2\"><b>Codes</b> de <a href=\"CodeSystem-taussig-adverse-event.html\" title=\"https://taussig/fhir/CodeSystem/taussig-adverse-event\">TAUSSIG — Complications</a></td><td/><td colspan=\"2\"><b>Codes</b> de <a href=\"CodeSystem-echsa.html\" title=\"https://taussig/fhir/CodeSystem/echsa\">TAUSSIG — ECHSA (nomenclature EACTS-ECHSA, représentation POC)</a></td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-AE-0001</td><td style=\"border-left-width: 0px\">Absence de complication post-procédurale</td><td colspan=\"4\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-AE-0002</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Complication liée à une intervention</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">CP-2010-900</td><td style=\"border-left-width: 0px\">Other complication</td><td>« autre complication »</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-narrower\" title=\"narrower\">maps to narrower concept</a></td><td style=\"border-right-width: 0px\">CP-2019-IC-10</td><td style=\"border-left-width: 0px\">Complication of cardiovascular catheterization procedure</td><td>complication de cathétérisme seulement</td></tr><tr><td style=\"border-right-width: 0px\">TAUSSIG-AE-0003</td><td style=\"border-left-width: 0px\">Arrêt cardiaque pendant l'intervention</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">CP2</td><td style=\"border-left-width: 0px\">Cardiac arrest, Timing = Cardiac arrest (MI) during or following procedure (Perioperative/Periprocedural = Intraoperative/Intraprocedural and/or Postoperative/Postprocedural)</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-AE-0004</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Fibrillation atriale</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">CP6</td><td style=\"border-left-width: 0px\">Arrhythmia</td><td>trouble du rythme</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">CP-2019-IC-01</td><td style=\"border-left-width: 0px\">Arrhythmia, Atrial, Atrial fibrillation</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-AE-0005</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Flutter atrial</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">CP6</td><td style=\"border-left-width: 0px\">Arrhythmia</td><td>trouble du rythme</td></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td style=\"border-right-width: 0px\">CP-2019-IC-02</td><td style=\"border-left-width: 0px\">Arrhythmia, Atrial, Atrial flutter</td><td/></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-AE-0006</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Trouble du rythme post-procédural</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td style=\"border-right-width: 0px\">CP6</td><td style=\"border-left-width: 0px\">Arrhythmia</td><td/></tr><tr><td style=\"border-right-width: 0px; border-top-style: none\"/><td style=\"border-top-style: none; border-left-width: 0px\"/><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td style=\"border-right-width: 0px\">CP-2019-IC-03</td><td style=\"border-left-width: 0px\">Arrhythmia, Atrial, Other</td><td>trouble du rythme atrial « autre »</td></tr><tr><td style=\"border-right-width: 0px; border-bottom-style: none\">TAUSSIG-AE-0007</td><td style=\"border-left-width: 0px; border-bottom-style: none\">Bloc atrioventriculaire complet acquis</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider