  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Narratif généré : CarteDeConcepts genetic-syndrome-to-echsa</b></p><a name=\"genetic-syndrome-to-echsa\"> </a><a name=\"hcgenetic-syndrome-to-echsa\"> </a><p>Mapping de <a href=\"ValueSet-taussig-genetic-syndrome.html\">TAUSSIG — Syndromes génétiques (Orphanet)</a> vers (non spécifié)</p><br/><p>Mapping de <code>http://www.orpha.net</code> to <a href=\"CodeSystem-echsa.html\">TAUSSIG — ECHSA (nomenclature EACTS-ECHSA, représentation POC)</a></p><table class=\"grid\"><tr><td><b>Code source</b></td><td><b>relation</b></td><td><b>Code cible</b></td><td><b>Commentaire</b></td></tr><tr><td>870 (Trisomie 21)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA9 (Down syndrome (Trisomy 21))</td><td/></tr><tr><td>881 (Syndrome de Turner)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA29 (Turner syndrome (45XO))</td><td/></tr><tr><td>567 (Syndrome de délétion 22q11.2)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA8 (DiGeorge syndrome (velocardiofacial syndrome) (conotruncal anomaly face syndrome) (22q11 deletion))</td><td>syndrome de DiGeorge / vélocardiofacial</td></tr><tr><td>3380 (Syndrome de trisomie 18)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA-2010-S-150 (Edwards syndrome (Trisomy 18))</td><td/></tr><tr><td>3378 (Syndrome de trisomie 13)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA-2010-S-360 (Patau syndrome (Trisomy 13))</td><td/></tr><tr><td>365 (Glycogénose par déficit en maltase acide)</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td>95 (Ataxie de Friedreich)</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td>98896 (Dystrophie musculaire de Duchenne)</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td>558 (Syndrome de Marfan)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA17 (Marfan syndrome)</td><td/></tr><tr><td>98249 (Syndrome d'Ehlers-Danlos)</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td>60030 (Syndrome de Loeys-Dietz)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA-2010-S-270 (Loeys-Dietz syndrome)</td><td/></tr><tr><td>648 (Syndrome de Noonan)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA-2010-S-350 (Noonan syndrome)</td><td/></tr><tr><td>805 (Sclérose tubéreuse de Bourneville)</td><td colspan=\"3\" style=\"background-color: #efefef\">(not mapped)</td></tr><tr><td>904 (Syndrome de Williams)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA10 (Williams syndrome (Williams-Beuren syndrome))</td><td/></tr><tr><td>52 (Syndrome d'Alagille)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA4 (Alagille syndrome (intrahepatic biliary duct agenesis))</td><td/></tr><tr><td>290 (Syndrome de rubéole congénitale)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>NCA7 (Fetal rubella syndrome (Congenital rubella syndrome))</td><td/></tr><tr><td>68341 (Anomalies congénitales multiples/syndrome dysmorphique)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-inexact\" title=\"inexact\">maps loosely to</a></td><td>NCA-2010-S-510 (Other syndromic abnormality(ies))</td><td>« autre anomalie syndromique »</td></tr></table></div>"
